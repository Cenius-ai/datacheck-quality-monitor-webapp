# Copy to `.env` if you want to override the development defaults.
# `sh install.sh` writes this file for you with a generated SESSION_SECRET.
# Every value below has a working default in datacheck/config.py, so the app
# also boots with no .env at all.

# Signs helper session state. Generate with: python3 -c "import secrets;print(secrets.token_hex(32))"
SESSION_SECRET=

# Embedded SQLite file, relative to the project root.
DATABASE_URL=sqlite:///./datacheck.db

# Dash binds this port on 0.0.0.0. 8050 is the framework default.
PORT=8050

# Optional tuning
# SESSION_COOKIE_NAME=datacheck_session
# SESSION_TTL_DAYS=7
# LOGIN_MAX_ATTEMPTS=10
# LOGIN_WINDOW_SECONDS=900
# ROWS_PER_DATASET=500
# HISTORY_RUNS=21
